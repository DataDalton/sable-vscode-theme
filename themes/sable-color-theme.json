	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#555555",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": {
				"foreground": "#6a9a6e"
			}
		},
		{
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#c8875c"
			}
		},
		{
			"scope": ["constant.language"],
			"settings": {
				"foreground": "#4d9bc8"
			}
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#4d9bc8"
			}
		},
		{
			"scope": ["keyword.operator"],
			"settings": {
				"foreground": "#909090"
			}
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": {
				"foreground": "#d4c490"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": {
				"foreground": "#5aafa5"
			}
		},
		{
			"scope": ["variable", "variable.other"],
			"settings": {
				"foreground": "#cacaca"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#b0a080"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#4d9bc8"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#d4c490"
			}
		},
		{
			"scope": ["punctuation"],
			"settings": {
				"foreground": "#808080"
			}
		},
		{
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": {
				"foreground": "#d4c490"
			}
		},
		{
			"scope": ["constant.character.escape"],
			"settings": {
				"foreground": "#4d9bc8"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"foreground": "#4d9bc8",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw"],
			"settings": {
				"foreground": "#6a9a6e"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function": "#d4c490",
		"method": "#d4c490",
		"variable": "#cacaca",
		"parameter": "#b0a080",
		"property": "#b0b0b0",
		"type": "#5aafa5",
		"class": "#5aafa5",
		"interface": "#5aafa5",
		"enum": "#5aafa5",
		"enumMember": "#c8875c",
		"namespace": "#8a8a8a"
	}
}
